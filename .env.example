# FTC Events API (https://ftc-events.firstinspires.org/services/API/register 에서 발급)
FTC_API_USER=
FTC_API_TOKEN=
# 시즌 시작 연도와 대회 코드. KRC 2027 코드가 나오면 바꾼다 (2026–27 시즌 = 2026)
KRC_SEASON=2025
KRC_EVENT_CODE=KRCMP
# 정식 주소 (공유 미리보기·검색에 쓰임). 예: https://krcalumni.com
SITE_URL=
# 서버가 받을 포트 (nginx가 이 포트로 넘김)
PORT=3000

# 웹 푸시 (경기 호출): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
# 자동 호출 실행 주소(/api/push/tick) 비밀 값 (systemd 타이머가 tick.mjs로 부름)
CRON_SECRET=
# 심판 입장 체크 화면(/live/queue) PIN
QUEUE_PIN=
# 로그인 쿠키 서명 키: openssl rand -hex 32 (바꾸면 모두 로그아웃)
SESSION_SECRET=
# 저장소: SQLite 파일과 팀 사진 폴더 (서버에서는 앱 폴더 밖, 예: /var/lib/krc-alumni/…)
DB_PATH=.data/krc.sqlite
UPLOAD_DIR=.data/uploads

# 오류 알림: 텔레그램 봇 토큰(@BotFather)과 받을 대화방 id (node scripts/telegram-chat-id.mjs로 확인)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
