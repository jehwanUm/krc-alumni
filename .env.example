# FTC Events API (https://ftc-events.firstinspires.org/services/API/register 에서 발급)
FTC_API_USER=
FTC_API_TOKEN=
# 시즌 시작 연도와 대회 코드. KRC 2027 코드가 나오면 바꾼다 (2026–27 시즌 = 2026)
KRC_SEASON=2025
KRC_EVENT_CODE=KRCMP
# 정식 도메인
SITE_URL=

# 웹 푸시 (경기 호출): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
# 자동 호출 실행 주소(/api/push/tick) 비밀 값 (cron-job.org 헤더 Authorization: Bearer <값>)
CRON_SECRET=
# 심판 입장 체크 화면(/live/queue) PIN
QUEUE_PIN=
# 저장소 (비우면 로컬 파일 .data/store.json, 개발용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
